<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../../Tsinswreng.CsTreeTest/Tsinswreng.CsTreeTest.csproj" />
    <!-- Program.cs 的新舊入口都用到了完整 DI（ServiceCollection/BuildServiceProvider），
         目前樣例仍需自行引用；DI 剝離改造完成後此引用應可移除 -->
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
    <!-- Directory.Build.props 全局釘死 Abstractions 6.0.0，與上面完整 DI 10.0.0 衝突，
         樣例工程內用 Update 提到 10.0.0（只影響本工程） -->
    <PackageReference Update="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
  </ItemGroup>

</Project>
