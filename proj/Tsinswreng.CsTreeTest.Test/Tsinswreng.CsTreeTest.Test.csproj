<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
	</PropertyGroup>

	<ItemGroup>
		<!-- 本倉測試直接本地引用庫源碼，不經過 NuGet。
		     本工程是測試程序集，調用方不會引用它，
		     所以它照真實測試工程的方式用真的微軟依賴注入。
		     「框架不依賴 DI」由框架自己的 csproj 保證，
		     不需要也不應該靠測試工程不用 DI 來證明。 -->
		<ProjectReference Include="../Tsinswreng.CsTreeTest/Tsinswreng.CsTreeTest.csproj" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.0" />
	</ItemGroup>

</Project>