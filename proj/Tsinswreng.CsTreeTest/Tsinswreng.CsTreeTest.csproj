<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageId>Tsinswreng.CsTreeTest</PackageId>
		<Version>0.2.0-alpha</Version>
		<Authors>Tsinswreng</Authors>
		<Description>Tree-structured test framework with explicit registration, index-based filtering, and parallel or ordered execution. No dependency-injection dependency.</Description>
		<PackageTags>Testing;Tree;UnitTest;Framework</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageLicenseExpression>MIT</PackageLicenseExpression>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<Copyright>Copyright (c) 2026 Tsinswreng</Copyright>
		<PackageProjectUrl>https://github.com/Tsinswreng/CsTreeTest</PackageProjectUrl>
		<RepositoryUrl>https://github.com/Tsinswreng/CsTreeTest</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
		<!-- Release/Pack 腳本需要 nupkg+snupkg -->
		<IncludeSymbols>true</IncludeSymbols>
		<SymbolPackageFormat>snupkg</SymbolPackageFormat>
		<IncludeSource>true</IncludeSource>
		<DebugType>portable</DebugType>
		<PublishRepositoryUrl>true</PublishRepositoryUrl>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="..\..\README.md" Pack="true" PackagePath="\" />
	</ItemGroup>

</Project>
