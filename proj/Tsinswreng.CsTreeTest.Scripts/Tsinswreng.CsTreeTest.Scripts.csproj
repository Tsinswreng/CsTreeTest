<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<TargetFramework>net10.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<!-- 各具名腳本的 Main(Root, CancellationToken) 由 Program dispatcher 直接呼叫，
		     不是 CLR entry point；CS0028 關掉 -->
		<NoWarn>$(NoWarn);CS0028</NoWarn>
	</PropertyGroup>

	<ItemGroup>
		<!-- 本倉庫不含 CsSh 源碼，固定從 NuGet 引用（與 Ngan.Dict/CsSql 的 Scripts 一致） -->
		<PackageReference Include="Tsinswreng.CsSh" Version="0.3.0-alpha" />
		<!-- 測試框架已不再依賴 DI；CsSh 自帶其 DI.Abstractions 傳遞依賴，
		     此 Update 只是把版本釘在 CsSh 自己要的 10.0.8。 -->
		<PackageReference Update="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.8" />
	</ItemGroup>

</Project>